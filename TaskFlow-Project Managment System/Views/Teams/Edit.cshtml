@model TaskFlow_Project_Managment_System.Models.ViewModels.EditTeamViewModel

@{
    ViewData["Title"] = "Edit Team";
}

<section class="workspace-page">
    <div class="tf-card workspace-form-card">
        <h1 class="tf-page-heading">Edit Team</h1>

        <p class="tf-muted workspace-form-card__description">
            Update the team name or description.
        </p>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="WorkspaceId" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Team name</label>
                <input asp-for="Name" class="form-control tf-form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description"
                          class="form-control tf-form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="workspace-form-card__actions">
                <a asp-controller="WorkSpace"
                   asp-action="Details"
                   asp-route-id="@Model.WorkspaceId"
                   class="btn tf-btn-outline">
                    Cancel
                </a>

                <button type="submit" class="btn tf-btn-primary">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}