@model TaskFlow_Project_Managment_System.Models.ViewModels.WorkspaceSwitcherViewModel

@{
    var selectedWorkspace = Model.Workspaces
        .FirstOrDefault(workspace => workspace.Id == Model.SelectedWorkspaceId);
}

<details class="tf-workspace-switcher">
    <summary class="tf-workspace-switcher__toggle">
        <span class="tf-workspace-switcher__name">
            <i class="bi bi-briefcase" aria-hidden="true"></i>

            @if (selectedWorkspace != null)
            {
                <span>@selectedWorkspace.Name</span>
            }
            else
            {
                <span>Select Workspace</span>
            }
        </span>

        <i class="bi bi-chevron-expand tf-workspace-switcher__arrow"
           aria-hidden="true"></i>
    </summary>

    <div class="tf-workspace-switcher__menu">
        @if (Model.Workspaces.Count == 0)
        {
            <span class="tf-workspace-switcher__empty">
                No Workspaces yet
            </span>
        }
        else
        {
            @foreach (var workspace in Model.Workspaces)
            {
                var isSelected = Model.SelectedWorkspaceId == workspace.Id;

                <a asp-controller="WorkSpace"
                   asp-action="Select"
                   asp-route-id="@workspace.Id"
                   class="tf-workspace-switcher__option @(isSelected ? "active" : "")"
                   aria-current="@(isSelected ? "page" : null)">
                    @workspace.Name
                </a>
            }
        }
    </div>
</details>