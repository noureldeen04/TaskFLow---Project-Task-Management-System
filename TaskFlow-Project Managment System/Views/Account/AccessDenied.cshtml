@{
    ViewData["Title"] = "Access denied";
}

<section class="tf-dashboard" aria-labelledby="access-denied-title">
    <div class="tf-card tf-card-body">
        <span class="tf-badge tf-badge-danger mb-3"><i class="bi bi-shield-lock" aria-hidden="true"></i> Access denied</span>
        <h1 class="tf-page-heading" id="access-denied-title">Workspace admin access required</h1>
        <p class="tf-page-subtitle">Your account does not have permission to view this page. Ask a workspace owner to grant the Admin role.</p>
    </div>
</section>
