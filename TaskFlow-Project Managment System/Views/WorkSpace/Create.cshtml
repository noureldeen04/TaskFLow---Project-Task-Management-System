@model TaskFlow_Project_Managment_System.Models.ViewModels.CreateWorkspaceViewModel

@{
    ViewData["Title"] = "Create Workspace";
}

<section class="workspace-page">
    <div class="workspace-form-card">
        <h1>Create Workspace</h1>
        <p class="workspace-form-card__description">
            Add a name and an optional description for your workspace.
        </p>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Workspace name</label>
                <input asp-for="Name" class="form-control" maxlength="100" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description"
                          class="form-control"
                          maxlength="500"
                          rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="workspace-form-card__actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}