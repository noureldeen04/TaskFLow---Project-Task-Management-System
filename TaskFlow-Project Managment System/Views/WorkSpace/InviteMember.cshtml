@model TaskFlow_Project_Managment_System.Models.ViewModels.InviteMemberViewModel

@{
    ViewData["Title"] = "Invite Member";
}

<section class="workspace-page">
    <div class="tf-card workspace-form-card">
        <h1 class="tf-page-heading">Invite Member</h1>

        <p class="tf-muted workspace-form-card__description">
            Create a pending invitation for someone to join this Workspace.
        </p>

        <form asp-action="InviteMember" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="WorkspaceId" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email"
                       type="email"
                       class="form-control tf-form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="workspace-form-card__actions">
                <a asp-controller="WorkSpace"
                   asp-action="Details"
                   asp-route-id="@Model.WorkspaceId"
                   class="btn tf-btn-outline">
                    Cancel
                </a>

                <button type="submit" class="btn tf-btn-primary">
                    Save Invitation
                </button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}